{
  "name": "claude-messenger",
  "version": "0.0.1-alpha.0",
  "description": "MSN Messenger 7-inspired Electron desktop client for Claude — independent reimplementation of codex-messenger using the Claude Agent SDK.",
  "author": "Thomas (Twinded)",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:preload": "node scripts/build-preload.mjs",
    "build": "npm run build:electron && npm run build:preload && npm run build:renderer",
    "clean": "rm -rf dist dist-electron release",
    "rebuild:native": "electron-rebuild",
    "postinstall": "electron-rebuild",
    "electron:dev": "node scripts/dev-electron.mjs",
    "electron:start": "npm run build && electron .",
    "test": "node --import tsx --test tests/*.test.mts",
    "audit:security": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "*",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^4.0.0",
    "keytar": "^7.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^41.3.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.59.1",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vite": "^7.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Twinded/claude-messenger.git"
  },
  "bugs": {
    "url": "https://github.com/Twinded/claude-messenger/issues"
  },
  "homepage": "https://github.com/Twinded/claude-messenger#readme",
  "build": {
    "appId": "com.twinded.claude-messenger",
    "productName": "Claude Messenger",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "package.json"
    ]
  }
}
